# Copy to .env.local for local dev. Never commit real values — .gitignore
# already excludes .env*.local, keep it that way.

# Neon Postgres connection string (from neon.tech project dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...

# Your numeric Telegram user ID (from @userinfobot) — the only chat_id
# the bot will ever respond to, per ARCHITECTURE.md §6
TELEGRAM_CHAT_ID=123456789

# Any long random string you generate yourself — must match what's
# configured as the webhook secret_token when the webhook is registered
TELEGRAM_WEBHOOK_SECRET=

# Any long random string you generate yourself — must match the header
# Apps Script sends as x-ingest-secret (Script Properties, INGEST_SECRET)
INGEST_SECRET=

# Any long random string you generate yourself — Vercel's own cron sends
# this automatically once set as an Authorization: Bearer header; see
# vercel.json
CRON_SECRET=
